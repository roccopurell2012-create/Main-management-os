# Copy this file to .env.local for local development, or configure each value
# directly in Vercel Project Settings > Environment Variables.
# Never commit .env.local or real credentials.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# For Supabase Postgres, paste the full provider CA certificate into this server-only variable.
SUPABASE_CA_CERT=

# Password reset email (Resend)
# Create a Resend API key and verify the sender domain before setting these values.
# Add the real values privately in Vercel; never send the API key in chat or commit it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rocco Creations <no-reply@your-verified-domain.example>
APP_BASE_URL=https://rocco-creations-portal.vercel.app
